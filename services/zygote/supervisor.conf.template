{%- if zygote.services %}
[program:zygote]
command=/usr/bin/env python baselayer/services/zygote/zygote.py %(ENV_FLAGS)s
; Fork from a single thread: no BLAS/OpenMP pools, no Arrow jemalloc thread
environment=PYTHONPATH=".",PYTHONUNBUFFERED=1,OPENBLAS_NUM_THREADS=1,MKL_NUM_THREADS=1,OMP_NUM_THREADS=1,JE_ARROW_MALLOC_CONF="background_thread:false"
stdout_logfile=log/zygote.log
redirect_stderr=true
priority=10
{%- endif %}
